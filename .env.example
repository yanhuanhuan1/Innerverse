# 方寸万象 / Innerverse
# Copy these values into Vercel Project Settings -> Environment Variables.
# Never commit real API keys or production secrets.

# Required for production persistence and user accounts.
DATABASE_URL=

# Required for email verification and password-account registration.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Innerverse <no-reply@your-domain.com>
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=45

# Public site URL, for example: https://your-domain.vercel.app
PUBLIC_BASE_URL=

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=true

# Optional Cloudflare R2 media storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Required for image/video generation through APIMart.
APIMART_API_KEY=

# Optional. Defaults to https://api.apimart.ai
APIMART_BASE_URL=https://api.apimart.ai

# Optional APIMart model overrides. Leave empty to use the built-in model lists.
# Values are comma-separated model ids.
APIMART_IMAGE_MODELS=
APIMART_VIDEO_MODELS=
APIMART_CHAT_MODELS=

# Optional public URL used when an upstream API must fetch local media by URL.
# On Vercel, set this to your production deployment URL after the first deploy.
PUBLIC_MEDIA_BASE_URL=

# Optional CORS allow-list. Comma-separated origins.
# Empty means local dev origins only. Same-origin production traffic usually
# does not need CORS.
ALLOWED_ORIGINS=

# Optional tuning.
REQUEST_TIMEOUT=1800
APIMART_IMAGE_TASK_TIMEOUT=1800
APIMART_IMAGE_POLL_INTERVAL=5
APIMART_IMAGE_INITIAL_POLL_DELAY=10
VIDEO_POLL_TIMEOUT=1800
