# 方寸万象 / Innerverse
# Copy values into Vercel Project Settings -> Environment Variables.
# Do not commit real API keys.

# Required for production persistence and user login.
DATABASE_URL=

# Optional fallback for email verification login through Resend.
# Email/password registration and sign-in do not require Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=方寸万象 <no-reply@your-domain.com>
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=45

# Example: https://your-domain.com
PUBLIC_BASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=true

# Optional R2 media storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Required for generation through APIMart.
APIMART_API_KEY=

# Optional. Defaults to https://api.apimart.ai
APIMART_BASE_URL=https://api.apimart.ai

# Optional model overrides. Leave empty to use the built-in model lists.
# Values are comma-separated model ids.
APIMART_IMAGE_MODELS=
APIMART_VIDEO_MODELS=
APIMART_CHAT_MODELS=

# Optional public URL used when an upstream API must fetch local media by URL.
# On Vercel, set this to your production deployment URL after the first deploy.
PUBLIC_MEDIA_BASE_URL=

# Optional tuning.
REQUEST_TIMEOUT=1800
APIMART_IMAGE_TASK_TIMEOUT=1800
APIMART_IMAGE_POLL_INTERVAL=5
APIMART_IMAGE_INITIAL_POLL_DELAY=10
VIDEO_POLL_TIMEOUT=1800
