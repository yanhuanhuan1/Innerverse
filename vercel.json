{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "functions": {
    "app.py": {
      "excludeFiles": "{python/**,packages/**,tests/**,__pycache__/**,_tmp_video_frames/**,assets/**,output/**,data/canvases/**,data/media_previews/**,server*.log,server.pid}"
    }
  }
}
